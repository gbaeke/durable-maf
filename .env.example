# Durable Task Scheduler emulator (docker run -p 8080:8080 -p 8082:8082 mcr.microsoft.com/dts/dts-emulator:latest)
DTS_ENDPOINT=http://localhost:8080
# Dedicated hub (isolated_v2 deployment). The emulator must be started with DTS_TASK_HUB_NAMES=durable-maf
TASKHUB=durable-maf

# agentgateway on this machine (~/.config/agentgateway/config.yaml)
GATEWAY_URL=http://localhost:4000/v1
# gpt-6-luna (OpenAI route) currently fails: the upstream OpenAI API key has expired.
# azure-gpt-6-luna routes to the same model via Azure Foundry. Switch back once the key is renewed.
MODEL=azure-gpt-6-luna
